#!/sbin/openrc-run
# OpenRC service for mcp-server-harmony (Streamable HTTP), e.g. in an Alpine LXC.
# Installed as /etc/init.d/mcp-server-harmony by install.sh. HTTP and Cloudflare
# Access settings live in /etc/mcp-server-harmony/env; the hub list (config.json)
# in /var/lib/mcp-server-harmony (the service user's own, 0700, since `check`
# writes it).

name="mcp-server-harmony"
description="MCP server for Logitech Harmony Hubs, over Streamable HTTP"

# supervise-daemon restarts the server if it exits (respawn_* below).
supervisor="supervise-daemon"
# run.sh loads /etc/mcp-server-harmony/env, then execs `mcp-server-harmony serve --http`.
command="/opt/mcp-server-harmony/run.sh"
command_user="mcp-harmony:mcp-harmony"
directory="/var/lib/mcp-server-harmony"
output_log="/var/log/mcp-server-harmony/server.log"
error_log="/var/log/mcp-server-harmony/server.log"
respawn_delay=5
respawn_max=10
respawn_period=300

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --directory --mode 0750 --owner mcp-harmony:mcp-harmony /var/log/mcp-server-harmony
	checkpath --directory --mode 0700 --owner mcp-harmony:mcp-harmony /var/lib/mcp-server-harmony
}
